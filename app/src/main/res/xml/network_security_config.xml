<?xml version="1.0" encoding="utf-8"?>
<!-- Plain-http is allowed ONLY so the scanner can inspect http:// links that users ask it to check.
     The app never sends user data or API keys over http: all API endpoints are https and use system CAs only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
